+/// Build the synchronous conditional-disagg replay config from a
+/// `KvRouterConfig`. Returns `None` (bypass disabled) unless conditional
+/// disagg is explicitly enabled, matching the production policy gate.
+fn conditional_disagg_config(
+    router_config: Option<&KvRouterConfig>,
+) -> Option<ConditionalDisaggReplayConfig> {
+    let config = router_config?;
+    if !config.conditional_disagg_enabled {
+        return None;
+    }
+    Some(ConditionalDisaggReplayConfig {
+        policy: replay_policy(config.conditional_disagg_policy),
+        eff_isl_threshold: config.conditional_disagg_eff_isl_threshold,
+        eff_isl_ratio_threshold: config.conditional_disagg_eff_isl_ratio_threshold,
+    })
+}
+
+/// 将生产的 `dynamo_kv_router::ConditionalDisaggPolicyKind` 转换为
+/// 离线核心的防火墙安全本地镜像。
+fn replay_policy(policy: dynamo_kv_router::config::ConditionalDisaggPolicyKind) -> ConditionalDisaggPolicyKind {
+    match policy {
+        dynamo_kv_router::config::ConditionalDisaggPolicyKind::IslBounding => {
+            ConditionalDisaggPolicyKind::IslBounding
+        }
+        dynamo_kv_router::config::ConditionalDisaggPolicyKind::PrefillLoad => {
+            ConditionalDisaggPolicyKind::PrefillLoad
+        }
+        dynamo_kv_router::config::ConditionalDisaggPolicyKind::IslOrLoad => {
+            ConditionalDisaggPolicyKind::IslOrLoad
+        }
+    }
+}
