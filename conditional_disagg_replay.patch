+/// Local mirror of the production `ConditionalDisaggPolicyKind`. The offline
+/// core must not reference the KV-router crate directly (enforced by the
+/// extension firewall); the extension layer converts the real policy into this
+/// copy before handing it to the runtime.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(in crate::replay) enum ConditionalDisaggPolicyKind {
+    IslBounding,
+    PrefillLoad,
+    IslOrLoad,
+}
+
+/// Subset of `KvRouterConfig` needed to drive conditional-disagg bypass in the
+/// offline replay. Kept small and `Copy` so the runtime can carry it cheaply.
+#[derive(Debug, Clone, Copy)]
+pub(in crate::replay) struct ConditionalDisaggReplayConfig {
+    pub(in crate::replay) policy: ConditionalDisaggPolicyKind,
+    pub(in crate::replay) eff_isl_threshold: usize,
+    pub(in crate::replay) eff_isl_ratio_threshold: f64,
+}
+
+impl ConditionalDisaggReplayConfig {
+    /// Synchronous mirror of the async `ConditionalDisaggPolicy` decision, so
+    /// the offline replay can evaluate bypass without an async runtime.
+    pub(in crate::replay) fn should_bypass(
+        self,
+        prompt_tokens: usize,
+        decode_chosen_cached_tokens: usize,
+        prefill_chosen_worker_busy: Option<bool>,
+    ) -> bool {
+        let eff_isl = prompt_tokens.saturating_sub(decode_chosen_cached_tokens.min(prompt_tokens));
+        let isl_bypass = eff_isl < self.eff_isl_threshold
+            && (eff_isl as f64 / prompt_tokens.max(1) as f64) < self.eff_isl_ratio_threshold;
+        let load_bypass = prefill_chosen_worker_busy.unwrap_or(false);
+        match self.policy {
+            ConditionalDisaggPolicyKind::IslBounding => isl_bypass,
+            ConditionalDisaggPolicyKind::PrefillLoad => load_bypass,
+            ConditionalDisaggPolicyKind::IslOrLoad => isl_bypass || load_bypass,
+        }
+    }
+}
+
+/// A `HandoffTransferTiming` that yields zero transfer delay: no bytes and no
+/// bandwidth are configured, so `delay_ms` resolves to `None` → `0.0`.
+fn zero_transfer_timing() -> HandoffTransferTiming {
+    HandoffTransferTiming {
+        mode: KvTransferTimingMode::FullPrompt,
+        full_prompt_tokens: 0,
+        kv_bytes_per_token: None,
+        bandwidth_gb_s: None,
+    }
+}
